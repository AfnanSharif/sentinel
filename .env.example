# ====================================================
# SENTINEL — Enterprise AI Customer Support Platform
# Environment Variables Configuration
# ====================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---------------------------------------------------
# OpenAI Configuration
# ---------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_CHAT_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1024

# ---------------------------------------------------
# Azure ML Configuration
# ---------------------------------------------------
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_RESOURCE_GROUP=sentinel-rg
AZURE_ML_WORKSPACE=sentinel-workspace
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# Azure App Service
AZURE_APP_SERVICE_NAME=sentinel-support-app
AZURE_APP_SERVICE_PLAN=sentinel-plan
AZURE_REGION=eastus

# ---------------------------------------------------
# FAISS Vector Database
# ---------------------------------------------------
FAISS_INDEX_PATH=./data/faiss_index
FAISS_INDEX_NAME=sentinel_support_index
FAISS_TOP_K=5
EMBEDDING_DIMENSION=1536

# ---------------------------------------------------
# Data Configuration
# ---------------------------------------------------
TICKET_DATA_PATH=./data/raw/retail_support_tickets.csv
PROCESSED_DATA_PATH=./data/processed

# ---------------------------------------------------
# RAG Configuration
# ---------------------------------------------------
MAX_CONTEXT_TOKENS=3000
NUM_RESPONSE_CANDIDATES=3
MIN_SIMILARITY_THRESHOLD=0.7
ENABLE_FEEDBACK_LOOP=true

# ---------------------------------------------------
# NLP Settings
# ---------------------------------------------------
SENTIMENT_THRESHOLD_POSITIVE=0.6
SENTIMENT_THRESHOLD_NEGATIVE=0.4
PRIORITY_KEYWORDS_HIGH=urgent,critical,broken,emergency,asap
PRIORITY_KEYWORDS_LOW=question,inquiry,information,curious

# ---------------------------------------------------
# Application Settings
# ---------------------------------------------------
APP_NAME=Sentinel Support Platform
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
STREAMLIT_PORT=8503

# ---------------------------------------------------
# Metrics & Monitoring
# ---------------------------------------------------
ENABLE_METRICS=true
METRICS_EXPORT_PATH=./data/metrics
RESPONSE_TIME_SLA_MS=2000
